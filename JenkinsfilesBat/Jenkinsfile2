pipeline {

    agent any

    environment{
        Test_env='prod'
        App_name='abctech'
      //  App_version='1.0.0'
    }

    parameters{
        choice(
            name: 'Deploy_Env',
            choices: ['SIT','UAT','PROD'],
            description: 'Select the environment'
        )

        booleanParam(
            name: 'Run_tests',
            defaultValue: true,
            description: 'Run Tests?'

        )

        string(
            name: 'App_version',
            defaultValue: '1.0.0',
            description: 'Application Version'
        )
    }
    stages{

        stage('checkout'){
            steps{
                bat '''
                    echo git checkout
                '''
            }
        }
         stage('Build'){
            steps{
                bat 'echo app version is %App_version%'
                bat '''
                    echo Build the code
                '''
                 echo Environment: %DEPLOY_ENV%
                    echo Version: %APP_VERSION%
                    echo Run Tests: %RUN_TESTS%
            }
        }
        stage('Test'){
            steps{

                echo "test runs on the app ${env.App_name}"
                bat '''
                    echo test the code
                '''
            }
        }
        stage('Print'){
            steps{
                bat '''
                    echo Print the result
                '''
            }
        }
    }
}